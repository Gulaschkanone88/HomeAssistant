@@ -0,0 +1,171 @@
+# =============================================================================
+# Einbindung der beiden Wärmepumpen-Blueprints
+# Für die Daikin-Rotex-HPSU, Stand 29.09.2026
+#
+# Ablage der Blueprints:
+#   config/blueprints/template/waermepumpe_cop.yaml
+#   config/blueprints/template/waermepumpe_arbeitszahl.yaml
+#
+# Was ein Blueprint leisten kann und was nicht
+#   Ein Template-Blueprint erzeugt laut Home-Assistant-Doku genau EINE
+#   Template-Entität. Mehrere Entitäten entstehen, indem derselbe Blueprint
+#   mehrfach eingebunden wird – unten dreimal für Tag, Monat und Jahr.
+#   Nicht als Blueprint abbildbar sind die Riemann-Integration, utility_meter
+#   und die filter-Plattform. Diese Teile stehen deshalb weiterhin direkt in
+#   der configuration.yaml.
+#   Eine Oberfläche zum Anlegen gibt es für Template-Blueprints nicht, die
+#   Einbindung läuft über YAML.
+# =============================================================================
+
+template:
+
+  # ---------------------------------------------------------------------------
+  # Vorstufe 1: bereinigte elektrische Leistung
+  # Der Z-Wave-Zähler liefert gelegentlich -214748340,5 W (-2^31/10, ein
+  # Registerüberlauf). Der Blueprint bekommt deshalb nicht den Rohsensor,
+  # sondern diesen hier.
+  # ---------------------------------------------------------------------------
+  - sensor:
+      - name: "WP Elektrische Leistung bereinigt"
+        unique_id: wp_p_el_bereinigt
+        unit_of_measurement: "W"
+        device_class: power
+        state_class: measurement
+        availability: "{{ has_value('sensor.hwr_warmepumpe_electric_consumption_w') }}"
+        state: >
+          {% set p = states('sensor.hwr_warmepumpe_electric_consumption_w') | float(0) %}
+          {{ p | round(1) if 0 <= p <= 12000 else none }}
+
+  # ---------------------------------------------------------------------------
+  # Vorstufe 2: nur positive Wärmeleistung
+  # Abtauzyklen und Kühlbetrieb liefern negative Werte. Unintegriert würde der
+  # Wärmemengenzähler rückwärts laufen.
+  # ---------------------------------------------------------------------------
+      - name: "WP Wärmeleistung positiv"
+        unique_id: wp_waermeleistung_positiv
+        unit_of_measurement: "kW"
+        device_class: power
+        state_class: measurement
+        availability: "{{ has_value('sensor.hpsu_can_thermische_leistung') }}"
+        state: >
+          {{ [ states('sensor.hpsu_can_thermische_leistung') | float(0), 0 ] | max | round(3) }}
+
+  # ---------------------------------------------------------------------------
+  # Blueprint 1: Momentan-COP
+  # Gemessen am 29.09.2026 während der Warmwasserbereitung: 4,17 kW thermisch
+  # bei 1510 W elektrisch, das ergibt 2,76.
+  # ---------------------------------------------------------------------------
+  - use_blueprint:
+      path: waermepumpe_cop.yaml
+      input:
+        thermal_power: sensor.hpsu_can_thermische_leistung
+        electrical_power: sensor.wp_elektrische_leistung_bereinigt
+        min_electrical_power: 200
+        min_thermal_power: 300
+        max_cop: 8
+        # Heizstab ist derzeit nicht am Netz – Liste bleibt leer.
+        # Nach einem Wiederanschluss hier eine Entität eintragen, die seinen
+        # Betrieb anzeigt, sonst fällt der COP in diesen Phasen zu gut aus.
+        blocking_entities: []
+    name: "WP COP aktuell"
+    unique_id: wp_cop_aktuell
+
+  # ---------------------------------------------------------------------------
+  # Blueprint 2: Arbeitszahlen, derselbe Blueprint dreimal
+  # ---------------------------------------------------------------------------
+  - use_blueprint:
+      path: waermepumpe_arbeitszahl.yaml
+      input:
+        heat_energy: sensor.wp_waermemenge_taeglich
+        electrical_energy: sensor.wp_strom_taeglich
+        min_energy: 0.5
+    name: "WP Arbeitszahl heute"
+    unique_id: wp_arbeitszahl_heute
+
+  - use_blueprint:
+      path: waermepumpe_arbeitszahl.yaml
+      input:
+        heat_energy: sensor.wp_waermemenge_monatlich
+        electrical_energy: sensor.wp_strom_monatlich
+        min_energy: 5
+    name: "WP Arbeitszahl Monat"
+    unique_id: wp_arbeitszahl_monat
+
+  - use_blueprint:
+      path: waermepumpe_arbeitszahl.yaml
+      input:
+        heat_energy: sensor.wp_waermemenge_jaehrlich
+        electrical_energy: sensor.wp_strom_jaehrlich
+        min_energy: 50
+    name: "WP Jahresarbeitszahl"
+    unique_id: wp_jahresarbeitszahl
+
+
+# =============================================================================
+# Nicht über Blueprints abbildbar
+# =============================================================================
+sensor:
+
+  # Geglätteter COP für die Anzeige. 15 Minuten glätten die Takte und bleiben
+  # reaktiv; für eine ruhige Dashboard-Kachel 30 bis 60 Minuten.
+  - platform: filter
+    name: "WP COP geglättet"
+    unique_id: wp_cop_geglaettet
+    entity_id: sensor.wp_cop_aktuell
+    filters:
+      - filter: time_simple_moving_average
+        window_size: "00:15"
+        precision: 2
+
+  # Wärmemengenzähler. Quelle ist kW, Zeitbasis Stunde, Ergebnis kWh – deshalb
+  # KEIN unit_prefix, sonst kommen MWh heraus. method: left passt zu einem
+  # Sensor, der nur bei Wertänderung aktualisiert; max_sub_interval integriert
+  # auch während langer konstanter Phasen weiter.
+  - platform: integration
+    source: sensor.wp_waermeleistung_positiv
+    name: "WP Wärmemenge"
+    unique_id: wp_waermemenge
+    unit_time: h
+    method: left
+    max_sub_interval: "00:05:00"
+    round: 3
+
+
+# =============================================================================
+# Zähler je Zeitraum
+# Wärme und Strom müssen über exakt denselben Zyklus laufen, sonst vergleicht
+# die Arbeitszahl zwei verschiedene Zeiträume. Wie wichtig das ist, zeigt eine
+# Gegenprobe mit den absoluten Lebenszeitzählern der Anlage: 2541 kWh Wärme
+# gegen 18699 kWh Strom ergibt 0,14 – die beiden Zähler haben schlicht nicht
+# zur selben Zeit angefangen.
+# =============================================================================
+utility_meter:
+  wp_waermemenge_taeglich:
+    source: sensor.wp_waermemenge
+    name: "WP Wärmemenge täglich"
+    cycle: daily
+  wp_waermemenge_monatlich:
+    source: sensor.wp_waermemenge
+    name: "WP Wärmemenge monatlich"
+    cycle: monthly
+  wp_waermemenge_jaehrlich:
+    source: sensor.wp_waermemenge
+    name: "WP Wärmemenge jährlich"
+    cycle: yearly
+
+  wp_strom_taeglich:
+    source: sensor.hwr_warmepumpe_electric_consumption_kwh
+    name: "WP Strom täglich"
+    cycle: daily
+  wp_strom_monatlich:
+    source: sensor.hwr_warmepumpe_electric_consumption_kwh
+    name: "WP Strom monatlich"
+    cycle: monthly
+  wp_strom_jaehrlich:
+    source: sensor.hwr_warmepumpe_electric_consumption_kwh
+    name: "WP Strom jährlich"
+    cycle: yearly
+
+# Nach dem Einspielen: Entwicklerwerkzeuge > YAML > Konfiguration prüfen,
+# dann neu starten. Die Arbeitszahlen brauchen einen vollen Zyklus, bevor sie
+# etwas Sinnvolles anzeigen.
